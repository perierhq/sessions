<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Hardened-runtime exceptions Electron's V8 needs. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Dictation — see entitlements.mac.plist. Keep the two files in step:
         this one signs the top-level app, that one every helper. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Universal links. Requires a Developer ID provisioning profile for
         electron-builder.yml's appId (restricted entitlement) — see README
         "Universal links". Left empty here: the release workflow fills in
         applinks:<host> and applinks:<host>?mode=developer from the
         OS1_SERVER_URL repository variable. The ?mode=developer alternate is
         for a tailnet-only host, which Apple's AASA CDN can't fetch, so
         devices verify the association directly with development mode on. -->
    <key>com.apple.developer.associated-domains</key>
    <array/>
  </dict>
</plist>
