# One public origin for signed webhooks, remote Sandbox callbacks and workload
# identity. The local gateway owns the exact method/path allowlist and returns
# 404 for everything else. Never proxy this hostname to the private app on 3850.
ingress.example.com {
    # BEGIN OPENSESSION SANDBOX INGRESS
    handle {
        # Hold requests while the gateway restarts instead of answering 502:
        # webhook senders do not redeliver.
        reverse_proxy 127.0.0.1:3860 {
            lb_try_duration 15s
            lb_try_interval 250ms
            stream_close_delay 1h
        }
    }
    # END OPENSESSION SANDBOX INGRESS
}
